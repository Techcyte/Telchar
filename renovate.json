{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Automerge mature non-breaking dependency updates",
      "matchUpdateTypes": [
        "digest",
        "pin",
        "patch",
        "minor",
        "lockFileMaintenance"
      ],
      "minimumReleaseAge": "14 days",
      "internalChecksFilter": "strict",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Lock file maintenance has no release timestamp, so a release age would hold it pending forever",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "minimumReleaseAge": null
    }
  ]
}
